{
  "name": "nsty-browser",
  "version": "0.6.2",
  "description": "Personal browser combining Brave ad blocking, Arc sidebar workspaces, and Claude AI integration",
  "main": "dist/main/main/index.js",
  "author": "Hafiz",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "electron .",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:all",
    "lint:types": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint:style": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "lint:all": "npm run lint:types && npm run lint:style",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@ghostery/adblocker": "^2.14.1",
    "@ghostery/adblocker-electron": "^2.14.1",
    "better-sqlite3": "^12.11.1",
    "cross-fetch": "^4.1.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^42.11.2",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
